# Marketa — Frontend Environment
#
# Copy to `.env` inside the `frontend/` folder:
#   cp .env.example .env
#
# In local development the Vite dev server proxies /api and /uploads to the
# backend at http://127.0.0.1:8000 (see vite.config.js), so this is only
# required when the frontend is served separately from the API — e.g. a
# production build behind a different host.

VITE_API_URL=http://localhost:8000/api/v1
