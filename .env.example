# =============================================================================
# Marketa — Environment Configuration
#
# Copy this file to `.env` in the repository root and fill in real values.
# `.env` is gitignored — NEVER commit it or any file containing real secrets.
#
#   cp .env.example .env
# =============================================================================

# ── PostgreSQL Database ──────────────────────────────────────────────────────
# The backend builds its connection string as:
#   postgresql://PG_USER:PG_PASSWORD@PG_HOSTNAME/PG_DBNAME
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_DBNAME=marketa
PG_HOSTNAME=localhost

# ── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── App Settings ─────────────────────────────────────────────────────────────
APP_NAME="Marketa"
DEBUG=false

# Comma-separated allow-list of browser origins permitted to call the API.
# Never use "*" — the API sends credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Public base URL of the frontend, used to build links in transactional emails
# (email verification, password reset).
FRONTEND_URL=http://localhost:3000

# ── File Uploads ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# ── SMTP / Transactional Email ───────────────────────────────────────────────
# Optional. Leave SMTP_HOST blank to disable outbound email in local dev.
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords),
# never your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=noreply@marketa.com
SMTP_FROM_NAME=Marketa

# ── Groq LLM (AI Chatbot) ────────────────────────────────────────────────────
# Optional. Leave blank to run without the chatbot's LLM responses.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
